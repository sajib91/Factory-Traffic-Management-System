@baseUrl = http://127.0.0.1:8000/api
@junction = A
@command = replace-with-pending-command-id

### List junctions
GET {{baseUrl}}/junctions
Accept: application/json

### Create a junction
POST {{baseUrl}}/junctions
Content-Type: application/json

{"id":"B","name":"Loading Bay","config":{"directions":["NORTH","SOUTH","EAST","WEST"],"phases":[{"name":"NORTH_SOUTH","green":["NORTH","SOUTH"],"duration":30},{"name":"EAST_WEST","green":["EAST","WEST"],"duration":30}],"timings":{"min_green":10,"yellow":5,"all_red":2}}}

### Get a junction
GET {{baseUrl}}/junctions/{{junction}}
Accept: application/json

### Get live status
GET {{baseUrl}}/junctions/{{junction}}/status
Accept: application/json

### Send a sensor arrival
POST {{baseUrl}}/sensor-events
Content-Type: application/json

{"event_id":"evt-demo-1","junction_id":"A","direction":"NORTH","vehicle_type":"CAR","event_type":"VEHICLE_ARRIVED","vehicle_id":"vehicle-demo-1","sequence_no":1,"occurred_at":"2026-01-01T00:00:00Z"}

### Request manual green
POST {{baseUrl}}/junctions/{{junction}}/commands
Content-Type: application/json

{"command":"GREEN_NS"}

### Send a controller ACK
POST {{baseUrl}}/controller-events
Content-Type: application/json

{"junction_id":"A","event_type":"ACK","command_id":"{{command}}","actual_signals":{"NORTH":"GREEN","SOUTH":"GREEN","EAST":"RED","WEST":"RED"}}

### Send a controller status event
POST {{baseUrl}}/controller-events
Content-Type: application/json

{"junction_id":"A","event_type":"OFFLINE","reason":"simulated disconnect"}

### Get history
GET {{baseUrl}}/junctions/{{junction}}/history?limit=50&type=
Accept: application/json
